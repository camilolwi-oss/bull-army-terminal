//@version=6
// ══════════════════════════════════════════════════════════════════════
//  Bull Army · Oscillators Pro
//  Oscilador compuesto (RSI · Estocástico · MFI · CCI · TSI)
//  + flujo de dinero (CMF) + volumen relativo + franjas de confluencia
//  + giros en zona extrema + divergencias + Order Blocks con confluencia
//  @bullarmyoficial en todas las redes · Visitanos en discord.gg/BullArmy
// ══════════════════════════════════════════════════════════════════════
indicator("Bull Army · Aurora", shorttitle = "Aurora", overlay = false,
     max_boxes_count = 500, max_lines_count = 300, max_bars_back = 500)

// ─────────────────────────── Grupos ───────────────────────────
const string G_OSC  = "Oscilador compuesto"
const string G_LVL  = "Niveles"
const string G_FLOW = "Flujo de dinero"
const string G_VOL  = "Volumen relativo"
const string G_STR  = "Franjas de confluencia"
const string G_SIG  = "Señales"
const string G_DIV  = "Divergencias"
const string G_OB   = "Order Blocks"
const string G_UI   = "Colores y panel"

// ─────────────────────────── Inputs ───────────────────────────
src       = input.source(close, "Fuente", group = G_OSC)
useRsi    = input.bool(true, "RSI",         group = G_OSC, inline = "rsi")
rsiLen    = input.int(14, "", minval = 2,   group = G_OSC, inline = "rsi")
useSto    = input.bool(true, "Estocástico", group = G_OSC, inline = "sto")
stoLen    = input.int(14, "", minval = 2,   group = G_OSC, inline = "sto")
stoSm     = input.int(3,  "", minval = 1,   group = G_OSC, inline = "sto")
useMfi    = input.bool(true, "MFI",         group = G_OSC, inline = "mfi")
mfiLen    = input.int(14, "", minval = 2,   group = G_OSC, inline = "mfi")
useCci    = input.bool(true, "CCI",         group = G_OSC, inline = "cci")
cciLen    = input.int(20, "", minval = 2,   group = G_OSC, inline = "cci")
useTsi    = input.bool(true, "TSI",         group = G_OSC, inline = "tsi")
tsiShort  = input.int(13, "", minval = 2,   group = G_OSC, inline = "tsi")
tsiLong   = input.int(25, "", minval = 2,   group = G_OSC, inline = "tsi")
smoothLen = input.int(4, "Suavizado (EMA)", minval = 1, group = G_OSC,
     tooltip = "Suaviza el promedio de los osciladores. Más alto = línea más limpia, pero con más retraso.")

obLevel   = input.float(50.0,  "Sobrecompra", group = G_LVL, inline = "lv")
osLevel   = input.float(-50.0, "Sobreventa",  group = G_LVL, inline = "lv")

showFlow  = input.bool(true, "Mostrar flujo de dinero (CMF)", group = G_FLOW)
flowLen   = input.int(21, "Longitud",  minval = 2, group = G_FLOW, inline = "fl")
flowSm    = input.int(5,  "Suavizado", minval = 1, group = G_FLOW, inline = "fl")
flowGain  = input.float(1.0, "Escala", minval = 0.1, step = 0.1, group = G_FLOW)

showVol   = input.bool(true, "Mostrar volumen relativo", group = G_VOL)
volLen    = input.int(50, "Media de volumen", minval = 5, group = G_VOL)
volHeight = input.float(30.0, "Altura de la banda", minval = 5, group = G_VOL)

showStrips = input.bool(true, "Mostrar franjas", group = G_STR)
stripThr   = input.float(20.0, "Umbral", minval = 0, maxval = 90, group = G_STR,
     tooltip = "Cada oscilador enciende su franja superior (alcista) o inferior (bajista) cuando su valor normalizado (±100) supera este umbral. Más intensidad = más extremo.")

showSig   = input.bool(true, "Giros en zona extrema (triángulos)", group = G_SIG)
sigCool   = input.int(5, "Separación mínima entre señales (velas)", minval = 0, group = G_SIG)

showDiv    = input.bool(true, "Mostrar divergencias", group = G_DIV)
divOnChart = input.bool(true, "Dibujar divergencia también en el precio", group = G_DIV)
divL       = input.int(5, "Pivote izq.", minval = 1, group = G_DIV, inline = "pv")
divR       = input.int(3, "der.",        minval = 1, group = G_DIV, inline = "pv")
divMin     = input.int(5,  "Distancia mín.", minval = 1, group = G_DIV, inline = "dd")
divMax     = input.int(60, "máx.",           minval = 5, group = G_DIV, inline = "dd")

showOB     = input.bool(true, "Mostrar Order Blocks en el gráfico", group = G_OB)
obSwing    = input.int(10, "Largo de swing (estructura)", minval = 2, group = G_OB,
     tooltip = "Velas a cada lado para confirmar un swing. La ruptura (cierre) de ese swing es el BOS que valida el OB.")
obBody     = input.bool(false, "Refinar la zona al cuerpo", group = G_OB)
obConfWin  = input.int(3, "Ventana de confluencia (velas)", minval = 0, group = G_OB,
     tooltip = "El OB tiene confluencia si el oscilador estaba en sobreventa (OB alcista) o sobrecompra (OB bajista) dentro de ± estas velas respecto a la vela del OB.")
obOnlyConf = input.bool(false, "Solo OB con confluencia", group = G_OB)
obMax      = input.int(5, "OB activos por lado", minval = 1, maxval = 20, group = G_OB)
obKeep     = input.bool(false, "Dejar OB invalidados (en gris)", group = G_OB)
obPane     = input.bool(true, "Marcar OB con confluencia en el oscilador", group = G_OB)

cBull    = input.color(#29E6C9, "Alcista", group = G_UI, inline = "c1")
cBear    = input.color(#FF4F7B, "Bajista", group = G_UI, inline = "c1")
cFlowUp  = input.color(#1DB978, "Flujo +", group = G_UI, inline = "c2")
cFlowDn  = input.color(#D8344F, "Flujo −", group = G_UI, inline = "c2")
cGold    = input.color(#C9A227, "Acento (OB · divergencias)", group = G_UI)
showGlow = input.bool(true, "Efecto glow", group = G_UI)
showTbl  = input.bool(true, "Panel de lectura", group = G_UI)

// ─────────────────────── Oscilador compuesto ───────────────────────
f_clamp(float v) => math.max(-100.0, math.min(100.0, v))

// Cada oscilador normalizado a ±100 (0 = neutral)
float nRsi = (ta.rsi(src, rsiLen) - 50.0) * 2.0
float nSto = (ta.sma(ta.stoch(src, high, low, stoLen), stoSm) - 50.0) * 2.0
float nMfi = (ta.mfi(hlc3, mfiLen) - 50.0) * 2.0
float nCci = f_clamp(ta.cci(hlc3, cciLen) / 2.0)
float nTsi = f_clamp(ta.tsi(src, tsiShort, tsiLong) * 200.0)

f_acc(bool use, float v) =>
    bool ok = use and not na(v)
    [ok ? v : 0.0, ok ? 1 : 0, ok and v > 0 ? 1 : 0]

[s1, c1, b1] = f_acc(useRsi, nRsi)
[s2, c2, b2] = f_acc(useSto, nSto)
[s3, c3, b3] = f_acc(useMfi, nMfi)
[s4, c4, b4] = f_acc(useCci, nCci)
[s5, c5, b5] = f_acc(useTsi, nTsi)

int   oscCnt  = c1 + c2 + c3 + c4 + c5
int   bullCnt = b1 + b2 + b3 + b4 + b5
float rawOsc  = oscCnt > 0 ? (s1 + s2 + s3 + s4 + s5) / oscCnt : na
float osc     = ta.ema(rawOsc, smoothLen)

bool  rising  = osc >= osc[1]
color oscCol  = rising ? cBull : cBear

// ─────────────────────── Flujo de dinero (CMF) ───────────────────────
float rng    = high - low
float mfm    = rng > 0 ? ((close - low) - (high - close)) / rng : 0.0
float vol    = nz(volume)
float volSum = math.sum(vol, flowLen)
float cmf    = volSum > 0 ? math.sum(mfm * vol, flowLen) / volSum : 0.0
float flow   = ta.ema(cmf * 100.0 * flowGain, flowSm)

// ─────────────────────── Volumen relativo ───────────────────────
float vAvg   = ta.sma(vol, volLen)
float rvol   = vAvg > 0 ? vol / vAvg : 0.0
float rvolS  = ta.ema(rvol, 3)
float volTop = -100.0 + math.min(rvolS, 3.0) / 3.0 * volHeight
color volBase = flow >= 0 ? cBull : cBear
color volCol  = color.from_gradient(rvolS, 0.5, 2.5, color.new(volBase, 92), color.new(volBase, 55))

// ─────────────────────── Giros en zona extrema ───────────────────────
bool turnDn = osc < osc[1] and osc[1] >= osc[2] and osc[1] > obLevel
bool turnUp = osc > osc[1] and osc[1] <= osc[2] and osc[1] < osLevel

var int lastDn = -100000
var int lastUp = -100000
bool sigDn = turnDn and bar_index - lastDn > sigCool
bool sigUp = turnUp and bar_index - lastUp > sigCool
if sigDn
    lastDn := bar_index
if sigUp
    lastUp := bar_index

// ─────────────────────── Divergencias regulares ───────────────────────
float phO   = ta.pivothigh(osc, divL, divR)
float plO   = ta.pivotlow(osc, divL, divR)
float hiWin = ta.highest(high, divR * 2 + 1)   // máximo de precio alrededor del pivote
float loWin = ta.lowest(low,  divR * 2 + 1)    // mínimo de precio alrededor del pivote

var float dPhOsc = na
var float dPhPx  = na
var int   dPhBar = na
var float dPlOsc = na
var float dPlPx  = na
var int   dPlBar = na

bool bearDiv = false
bool bullDiv = false

if not na(phO)
    int curBar = bar_index - divR
    if not na(dPhBar)
        int dist = curBar - dPhBar
        // Precio hace máximo más alto, oscilador hace máximo más bajo
        if dist >= divMin and dist <= divMax and phO < dPhOsc and hiWin > dPhPx and dPhOsc > 0
            bearDiv := true
            if showDiv
                line.new(dPhBar, dPhOsc, curBar, phO, color = cGold, style = line.style_dotted, width = 1)
                if divOnChart
                    line.new(dPhBar, dPhPx, curBar, hiWin, color = cGold, style = line.style_dotted, width = 1, force_overlay = true)
    dPhOsc := phO
    dPhPx  := hiWin
    dPhBar := curBar

if not na(plO)
    int curBar = bar_index - divR
    if not na(dPlBar)
        int dist = curBar - dPlBar
        // Precio hace mínimo más bajo, oscilador hace mínimo más alto
        if dist >= divMin and dist <= divMax and plO > dPlOsc and loWin < dPlPx and dPlOsc < 0
            bullDiv := true
            if showDiv
                line.new(dPlBar, dPlOsc, curBar, plO, color = cGold, style = line.style_dotted, width = 1)
                if divOnChart
                    line.new(dPlBar, dPlPx, curBar, loWin, color = cGold, style = line.style_dotted, width = 1, force_overlay = true)
    dPlOsc := plO
    dPlPx  := loWin
    dPlBar := curBar

// ─────────────────────── Order Blocks (estructura) ───────────────────────
float pivH = ta.pivothigh(high, obSwing, obSwing)
float pivL = ta.pivotlow(low,  obSwing, obSwing)

var float swH     = na
var int   swHBar  = na
var bool  swHDone = true
var float swL     = na
var int   swLBar  = na
var bool  swLDone = true

if not na(pivH)
    swH     := pivH
    swHBar  := bar_index - obSwing
    swHDone := false
if not na(pivL)
    swL     := pivL
    swLBar  := bar_index - obSwing
    swLDone := false

var array<box> bullOBs = array.new<box>()
var array<box> bearOBs = array.new<box>()

// Gestión de OB activos: se invalidan con cierre del otro lado de la zona
int nBull = array.size(bullOBs)
if nBull > 0
    for i = nBull - 1 to 0
        box b = array.get(bullOBs, i)
        if close < box.get_bottom(b)
            array.remove(bullOBs, i)
            if obKeep
                box.set_right(b, bar_index)
                box.set_bgcolor(b, color.new(color.gray, 90))
                box.set_border_color(b, color.new(color.gray, 70))
                box.set_text_color(b, color.new(color.gray, 50))
            else
                box.delete(b)
        else
            box.set_right(b, bar_index + 3)

int nBear = array.size(bearOBs)
if nBear > 0
    for i = nBear - 1 to 0
        box b = array.get(bearOBs, i)
        if close > box.get_top(b)
            array.remove(bearOBs, i)
            if obKeep
                box.set_right(b, bar_index)
                box.set_bgcolor(b, color.new(color.gray, 90))
                box.set_border_color(b, color.new(color.gray, 70))
                box.set_text_color(b, color.new(color.gray, 50))
            else
                box.delete(b)
        else
            box.set_right(b, bar_index + 3)

bool newBullOB   = false
bool newBullConf = false
bool newBearOB   = false
bool newBearConf = false

// BOS alcista → OB alcista = vela con el mínimo más bajo del tramo
if not swHDone and close > swH
    swHDone := true
    int span = math.min(bar_index - swHBar, 300)
    if span >= 1
        int   idx  = 1
        float minL = low[1]
        for i = 1 to span
            if low[i] < minL
                minL := low[i]
                idx  := i
        float top = obBody ? math.max(open[idx], close[idx]) : high[idx]
        float bot = low[idx]
        bool conf = false
        for j = math.max(idx - obConfWin, 0) to idx + obConfWin
            if osc[j] <= osLevel
                conf := true
        newBullOB   := true
        newBullConf := conf
        if showOB and (conf or not obOnlyConf)
            box b = box.new(bar_index - idx, top, bar_index + 3, bot,
                 border_color = conf ? cGold : color.new(cBull, 40), border_width = conf ? 2 : 1,
                 bgcolor = color.new(cBull, conf ? 78 : 88), text = conf ? "OB ✓" : "OB",
                 text_color = conf ? cGold : cBull, text_size = size.tiny, text_halign = text.align_right,
                 force_overlay = true)
            array.push(bullOBs, b)
            if array.size(bullOBs) > obMax
                box.delete(array.shift(bullOBs))
        if obPane and conf
            box.new(bar_index - idx, -131.0, bar_index, -139.0, border_color = cGold,
                 bgcolor = color.new(cGold, 15), text = "OB", text_color = #0B0B0C, text_size = size.tiny)

// BOS bajista → OB bajista = vela con el máximo más alto del tramo
if not swLDone and close < swL
    swLDone := true
    int span = math.min(bar_index - swLBar, 300)
    if span >= 1
        int   idx  = 1
        float maxH = high[1]
        for i = 1 to span
            if high[i] > maxH
                maxH := high[i]
                idx  := i
        float top = high[idx]
        float bot = obBody ? math.min(open[idx], close[idx]) : low[idx]
        bool conf = false
        for j = math.max(idx - obConfWin, 0) to idx + obConfWin
            if osc[j] >= obLevel
                conf := true
        newBearOB   := true
        newBearConf := conf
        if showOB and (conf or not obOnlyConf)
            box b = box.new(bar_index - idx, top, bar_index + 3, bot,
                 border_color = conf ? cGold : color.new(cBear, 40), border_width = conf ? 2 : 1,
                 bgcolor = color.new(cBear, conf ? 78 : 88), text = conf ? "OB ✓" : "OB",
                 text_color = conf ? cGold : cBear, text_size = size.tiny, text_halign = text.align_right,
                 force_overlay = true)
            array.push(bearOBs, b)
            if array.size(bearOBs) > obMax
                box.delete(array.shift(bearOBs))
        if obPane and conf
            box.new(bar_index - idx, 139.0, bar_index, 131.0, border_color = cGold,
                 bgcolor = color.new(cGold, 15), text = "OB", text_color = #0B0B0C, text_size = size.tiny)

// ─────────────────────────── Dibujo ───────────────────────────
hline(0,       "Cero",        color.new(color.gray, 60), hline.style_dashed)
hline(obLevel, "Sobrecompra", color.new(color.gray, 75), hline.style_dotted)
hline(osLevel, "Sobreventa",  color.new(color.gray, 75), hline.style_dotted)
hline(145,  "Techo", color.new(color.gray, 100), editable = false)   // fija la escala para franjas y marcas OB
hline(-145, "Piso",  color.new(color.gray, 100), editable = false)

// Banda de volumen relativo (base en -100)
plot(showVol ? volTop : na, "Volumen relativo", volCol, style = plot.style_columns, histbase = -100.0)

// Flujo de dinero con relleno degradé hacia cero
pZero = plot(0, "Base flujo", color = na, display = display.none, editable = false)
pFlow = plot(showFlow ? flow : na, "Flujo de dinero", flow >= 0 ? cFlowUp : cFlowDn, 2)
fill(pFlow, pZero,
     flow > 0 ? flow : 0.0, flow > 0 ? 0.0 : flow,
     flow > 0 ? color.new(cFlowUp, 55) : color.new(cFlowDn, 100),
     flow > 0 ? color.new(cFlowUp, 100) : color.new(cFlowDn, 55),
     title = "Relleno flujo")

// Oscilador principal con glow
plot(showGlow ? osc : na, "Glow externo", color.new(oscCol, 88), 9, editable = false)
plot(showGlow ? osc : na, "Glow interno", color.new(oscCol, 72), 5, editable = false)
plot(osc, "Oscilador", oscCol, 2)

// Franjas de confluencia: arriba = alcista, abajo = bajista (una fila por oscilador)
f_stripCol(float v, color c) =>
    color.from_gradient(math.abs(v), stripThr, 100.0, color.new(c, 85), color.new(c, 5))

plot(showStrips and useRsi and nRsi >  stripThr ?  106.0 : na, "RSI ▲",   f_stripCol(nRsi, cBull), 3, plot.style_linebr)
plot(showStrips and useSto and nSto >  stripThr ?  111.0 : na, "Estoc ▲", f_stripCol(nSto, cBull), 3, plot.style_linebr)
plot(showStrips and useMfi and nMfi >  stripThr ?  116.0 : na, "MFI ▲",   f_stripCol(nMfi, cBull), 3, plot.style_linebr)
plot(showStrips and useCci and nCci >  stripThr ?  121.0 : na, "CCI ▲",   f_stripCol(nCci, cBull), 3, plot.style_linebr)
plot(showStrips and useTsi and nTsi >  stripThr ?  126.0 : na, "TSI ▲",   f_stripCol(nTsi, cBull), 3, plot.style_linebr)

plot(showStrips and useRsi and nRsi < -stripThr ? -106.0 : na, "RSI ▼",   f_stripCol(nRsi, cBear), 3, plot.style_linebr)
plot(showStrips and useSto and nSto < -stripThr ? -111.0 : na, "Estoc ▼", f_stripCol(nSto, cBear), 3, plot.style_linebr)
plot(showStrips and useMfi and nMfi < -stripThr ? -116.0 : na, "MFI ▼",   f_stripCol(nMfi, cBear), 3, plot.style_linebr)
plot(showStrips and useCci and nCci < -stripThr ? -121.0 : na, "CCI ▼",   f_stripCol(nCci, cBear), 3, plot.style_linebr)
plot(showStrips and useTsi and nTsi < -stripThr ? -126.0 : na, "TSI ▼",   f_stripCol(nTsi, cBear), 3, plot.style_linebr)

// Señales y divergencias
plotshape(showSig and sigDn ? osc[1] + 12 : na, "Giro bajista", shape.triangledown, location.absolute, cBear, size = size.tiny)
plotshape(showSig and sigUp ? osc[1] - 12 : na, "Giro alcista", shape.triangleup,   location.absolute, cBull, size = size.tiny)
plotshape(showDiv and bearDiv ? phO : na, "Divergencia bajista", shape.circle, location.absolute, cGold, offset = -divR, size = size.tiny)
plotshape(showDiv and bullDiv ? plO : na, "Divergencia alcista", shape.circle, location.absolute, cGold, offset = -divR, size = size.tiny)

// ─────────────────────── Panel de lectura ───────────────────────
var table tbl = table.new(position.top_right, 2, 4, bgcolor = color.new(#0B0B0C, 15),
     frame_color = color.new(cGold, 60), frame_width = 1)

if showTbl and barstate.islast
    string zona = osc > obLevel ? "Sobrecompra" : osc < osLevel ? "Sobreventa" : "Neutral"
    table.cell(tbl, 0, 0, "Oscilador", text_color = color.gray, text_size = size.small, text_halign = text.align_left)
    table.cell(tbl, 1, 0, str.tostring(osc, "#.0"), text_color = oscCol, text_size = size.small)
    table.cell(tbl, 0, 1, "Consenso", text_color = color.gray, text_size = size.small, text_halign = text.align_left)
    table.cell(tbl, 1, 1, str.tostring(bullCnt) + "/" + str.tostring(oscCnt) + " alcistas",
         text_color = bullCnt * 2 >= oscCnt ? cBull : cBear, text_size = size.small)
    table.cell(tbl, 0, 2, "Flujo", text_color = color.gray, text_size = size.small, text_halign = text.align_left)
    table.cell(tbl, 1, 2, flow >= 0 ? "Comprador" : "Vendedor",
         text_color = flow >= 0 ? cFlowUp : cFlowDn, text_size = size.small)
    table.cell(tbl, 0, 3, "Zona", text_color = color.gray, text_size = size.small, text_halign = text.align_left)
    table.cell(tbl, 1, 3, zona, text_color = cGold, text_size = size.small)

// ─────────────────────────── Alertas ───────────────────────────
alertcondition(sigUp,   "BA · Giro alcista",        "{{ticker}} {{interval}} · Giro alcista del oscilador en sobreventa")
alertcondition(sigDn,   "BA · Giro bajista",        "{{ticker}} {{interval}} · Giro bajista del oscilador en sobrecompra")
alertcondition(bullDiv, "BA · Divergencia alcista", "{{ticker}} {{interval}} · Divergencia alcista confirmada")
alertcondition(bearDiv, "BA · Divergencia bajista", "{{ticker}} {{interval}} · Divergencia bajista confirmada")
alertcondition(newBullOB, "BA · Nuevo OB alcista",  "{{ticker}} {{interval}} · BOS alcista, nuevo OB de demanda")
alertcondition(newBearOB, "BA · Nuevo OB bajista",  "{{ticker}} {{interval}} · BOS bajista, nuevo OB de oferta")
alertcondition(newBullOB and newBullConf, "BA · OB alcista con confluencia", "{{ticker}} {{interval}} · OB alcista con oscilador en sobreventa")
alertcondition(newBearOB and newBearConf, "BA · OB bajista con confluencia", "{{ticker}} {{interval}} · OB bajista con oscilador en sobrecompra")
